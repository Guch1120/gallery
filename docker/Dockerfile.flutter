FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Tokyo
ENV LANG=ja_JP.UTF-8
ENV LC_ALL=ja_JP.UTF-8

ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_USER_HOME=/root/.android
ENV FLUTTER_ROOT=/opt/flutter
ENV PATH=${FLUTTER_ROOT}/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/build-tools/35.0.0:${PATH}

RUN apt-get update && apt-get install -y \
    locales tzdata ca-certificates curl wget unzip zip xz-utils \
    git git-lfs sudo bash-completion \
    openjdk-21-jdk \
    adb usbutils \
    clang cmake ninja-build pkg-config \
    python3 python3-pip \
    vim nano less procps psmisc \
 && locale-gen ja_JP.UTF-8 \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools

RUN cd /tmp \
 && wget -O commandlinetools.zip https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip \
 && unzip commandlinetools.zip -d /tmp/cmdline-tools \
 && mv /tmp/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
 && rm -rf /tmp/commandlinetools.zip /tmp/cmdline-tools

RUN yes | sdkmanager --licenses

RUN sdkmanager \
    "platform-tools" \
    "platforms;android-35" \
    "build-tools;35.0.0" \
    "ndk;27.0.12077973" \
    "cmake;3.22.1"

RUN cd /opt \
 && wget -O flutter.tar.xz https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.35.5-stable.tar.xz \
 && tar -xf flutter.tar.xz \
 && rm -f flutter.tar.xz

RUN git config --global --add safe.directory /opt/flutter

RUN flutter config --no-analytics \
 && flutter doctor

WORKDIR /workspace

CMD ["sleep", "infinity"]
